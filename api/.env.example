# Public repository that stores the Windows installer Releases.
GITHUB_OWNER=Muhammad5231
GITHUB_REPO=CashNote-Releases
STATS_CACHE_SECONDS=180

# CashNote Website repository used by the Admin Panel CMS.
CMS_GITHUB_OWNER=Muhammad5231
CMS_GITHUB_REPO=CashNote-Website
CMS_GITHUB_BRANCH=main
CMS_CONTENT_PATH=public/cms/content.json
CMS_GITHUB_TOKEN=github_pat_REPLACE_WITH_FINE_GRAINED_TOKEN

# Admin login/session secrets.
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS
ADMIN_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

SITE_URL=https://cashnote-website.onrender.com
ALLOWED_ORIGINS=https://cashnote-website.onrender.com,http://localhost:8080
PORT=10000
